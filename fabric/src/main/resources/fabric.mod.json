{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/Ariakan79/StoneGolem",
        "sources": "https://github.com/Ariakan79/StoneGolem",
        "issues": "https://github.com/Ariakan79/StoneGolem/issues"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "eu.ariakan.stonegolem.StoneGolemFabric"
        ],
        "client": [
            "eu.ariakan.stonegolem.client.StoneGolemFabricClient"
        ],
        "fabric-gametest": [
            "eu.ariakan.stonegolem.gametest.StoneGolemFabricGameTests"
        ],
        "fabric-client-gametest": [
            "eu.ariakan.stonegolem.client.gametest.StoneGolemClientGameTest",
            "eu.ariakan.stonegolem.client.gametest.StoneGolemShowcase"
        ]
    },
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}"
    }
}
  